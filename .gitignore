# env files
.env
.env.*
!.env.example

# Local environment config (credentials — never commit).
# quadratic.config.json is the pre-rename name, still ignored so a leftover
# copy can't be committed.
amplience.config.json
quadratic.config.json
amplience.config.json

# IDE settings
.vscode/settings.json
.vscode/css-custom-data.json
.idea

# Dependencies
node_modules

# Build output
dist
build
.next
out

# Next.js auto-generates next-env.d.ts on every dev/build/typegen and the
# contents differ between modes (see vercel/next.js#85738 + #86001). Per
# Vercel's official recommendation, keep it out of version control.
next-env.d.ts

# Cache
.turbo
.cache
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# misc
.DS_Store

# Test coverage
coverage

# QL-92 hub-import staging (INTERIM dc-cli wrapper)
packages/hub-management/.import
.vercel

# Flows and listeners pulled from a customer or sandbox hub. A pull lands here
# by default; `--shared` writes to the checked-in directory instead. Keeps a
# customer's brand names, and an extension instance's env, out of the repo.
packages/hub-management/flows/local/
packages/hub-management/webhook-listeners/local/

# Catalogue entries for a customer's own portable (UNLISTED) extensions. The id
# is theirs, so it is recorded locally rather than committed — see
# packages/hub-management/workforce-extensions/README.md.
packages/hub-management/workforce-extensions/local/

# Fixture sets built from a prospect's site (their copy, imagery and brand) —
# seeded and served like any other set, but never committed.
packages/content/fixtures/local/
