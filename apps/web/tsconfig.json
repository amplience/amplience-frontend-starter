{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Next.js needs the browser libs in addition to the ES2022 baseline. */
    "lib": ["DOM", "DOM.Iterable", "ES2022"],

    /* Next.js compiles JSX itself — leave it in source. */
    "jsx": "preserve",

    /* Incremental rebuilds + Next.js TS plugin. */
    "incremental": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],

    /* Allow Next.js's generated .js shims to be picked up by tsc. */
    "allowJs": true,

    /* Next 16's generated next-env.d.ts side-effect-imports
     * `./.next/dev/types/routes.d.ts` with an explicit .d.ts extension.
     * Safe under noEmit: true. */
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    /* TS globs skip dot-directories, so the DevTools well-known route needs
     * naming explicitly — otherwise tsc and typed lint silently ignore it. */
    "app/.well-known/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  /* vitest.config.ts is excluded so it lints under the projectService's
   * allowDefaultProject path (`apps/* /vitest.config.*`), like every other
   * workspace's vitest config. Vitest transpiles it itself. */
  "exclude": ["node_modules", "vitest.config.ts"]
}
