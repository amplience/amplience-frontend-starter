# Deployment configuration — copy to .env.local and adjust per deployment.
# Every value here has a sensible accelerator default; a client deployment
# overrides them rather than editing code.

# Site-wide metadata fallbacks (server-side, read at build time).
# Page content overrides these per-field via generateMetadata; these cover
# pages that don't set a field and routes with no content (e.g. the 404 page).
# SITE_TITLE also feeds the title template: "<page title> | <SITE_TITLE>".
SITE_TITLE="Quadratic Lite"
SITE_DESCRIPTION="Open-source accelerator for the Amplience Quadratic demo platform."

# Public origin of this deployment — the metadataBase that relative metadata
# URLs (canonical, og:image) resolve against. No trailing slash.
SITE_URL="http://localhost:3000"

# Where the favicon set lives. Filenames are fixed convention (favicon.ico,
# icon.svg, apple-touch-icon.png, icon-192.png, icon-512.png); only the base
# is configurable. Default is the bundled Quadratic set in public/favicon/ —
# either replace those files, or point this at your own host / Amplience
# Dynamic Media. No trailing slash.
FAVICON_BASE_URL="/favicon"

# Browser-chrome theme colour (web manifest + theme-color meta).
THEME_COLOR="#7340e7"

# Brand theme selector — sets <html data-brand>, which scopes the CSS-variable
# theme overrides (ADR-0002). One brand per deployment at POC/MVP.
NEXT_PUBLIC_BRAND="default"
