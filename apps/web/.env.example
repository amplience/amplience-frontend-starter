# Deployment configuration — copy to .env and adjust per deployment.
# Every value here has a sensible accelerator default; a client deployment
# overrides them rather than editing code.

# Site-wide metadata fallbacks (server-side, read at build time).
# Page content overrides these per-field via generateMetadata; these cover
# pages that don't set a field and routes with no content (e.g. the 404 page).
# SITE_TITLE also feeds the title template: "<page title> | <SITE_TITLE>".
SITE_TITLE="Amplience Frontend Starter"
SITE_DESCRIPTION="Open-source frontend accelerator for Amplience."

# Public origin of this deployment — the metadataBase that relative metadata
# URLs (canonical, og:image) resolve against. No trailing slash.
# Resolution chain: SITE_URL → VERCEL_PROJECT_PRODUCTION_URL (injected by
# Vercel automatically) → http://localhost:3000 for local dev. Set SITE_URL
# when deploying to a custom domain to keep canonicals correct.
SITE_URL="http://localhost:3000"

# Where the favicon set lives. Filenames are fixed convention (favicon.ico,
# icon.svg, apple-touch-icon.png, icon-192.png, icon-512.png); only the base
# is configurable. Default is the bundled Amplience set in public/favicon/ —
# either replace those files, or point this at your own host / Amplience
# Dynamic Media. No trailing slash.
FAVICON_BASE_URL="/favicon"

# Browser-chrome theme colour (web manifest + theme-color meta).
THEME_COLOR="#7340e7"

# Brand theme selector — sets <html data-brand>, which scopes the CSS-variable
# theme overrides (ADR-0002). One brand per deployment at POC/MVP.
NEXT_PUBLIC_BRAND="default"

# ── Content source (QL-43) ───────────────────────────────────────────────
# Hub name → the single switch between fixture data and a real Amplience hub.
# Set AMPLIENCE_HUB_NAME and the SDK client is used automatically; leave it
# unset (the default) and the bundled fixture data is served offline with no
# hub access needed. Not a credential, but it identifies the organisation a
# deployment serves — keep real client hub names in deployment env /
# per-owner config, not in a public repo. The value below is the public
# reference demo.
# AMPLIENCE_HUB_NAME="quadraticlite"

# Optional: site name — the delivery-key namespace this deployment serves
# (ADR-0014). Every key on the hub is <site>/<path>: the acme deployment's
# /about page is the item keyed acme/about. It names the frontend consumer
# (this app), not the brand — theming stays on NEXT_PUBLIC_BRAND above.
# Defaults to AMPLIENCE_HUB_NAME (hub-import seeds under the same default),
# so most deployments never set it; set it for a site not named after its
# hub. Lowercase letters, digits, and single hyphens. Choose it once, at
# hub setup: it is baked into every delivery key, so changing it later
# means re-keying all content. Without a hub, the mock serves the fixture
# site under its own name (base-site).
# SITE_NAME="my-site"

# Optional override — only needed to force mock while a hub name is set
# (useful for debugging fixture data alongside a live hub config).
# CONTENT_CLIENT="mock"

# Optional: virtual-staging (VSE) host. When set, reads serve the latest
# saved versions instead of published ones.
# AMPLIENCE_STAGING_HOST="g8tgyy0etx3f1hv243pqc24ci.staging.bigcontent.io"

# Optional: locale forwarded to the delivery API — the single-locale default
# for content reads when locale routing isn't configured.
# AMPLIENCE_LOCALE="en-GB"

# ── CMS-managed custom CSS (optional, off by default) ─────────────────────
# When "TRUE", an optional layer of custom CSS authored in the Site Components
# repo is fetched by delivery key ({SITE_NAME}/site/custom-css) and injected
# site-wide, after the design tokens, as an override. Off (or any other value)
# keeps the deployment pure-static with no CMS read — core theming stays in
# code. Must be set both locally and on the host. Leave unset for the
# code-managed default.
# AMPLIENCE_CUSTOM_CSS="TRUE"

# Optional: ISR revalidate window (seconds) for the custom-CSS read in
# production. Lower = fresher, higher = fewer delivery reads. Default 300.
# AMPLIENCE_CUSTOM_CSS_REVALIDATE="300"

# Optional: shared secret for the on-demand revalidation endpoint
# (POST /api/revalidate-custom-css). Point an Amplience "publish" webhook for
# the custom-CSS content type at that URL with this secret (x-revalidate-secret
# header or ?secret=) so published edits clear the cache immediately instead of
# waiting out the revalidate window. Unset → the endpoint is inert (501).
# AMPLIENCE_REVALIDATE_SECRET="change-me"

# ── Locale routing (ADR-0015) ────────────────────────────────────────────
# Optional: the locales this deployment serves, comma-separated Amplience
# locale codes. The FIRST is the default (unprefixed) locale; the rest are
# reachable under a lowercased path prefix — e.g. with "en-GB,fr-FR,de-DE",
# /about is English, /fr-fr/about is French, /de-de/about is German. Each
# locale is sent to the Delivery API with a wildcard fallback (en-GB → en-GB,*)
# so a field missing that locale still resolves. Unset → a single en-US
# default (or AMPLIENCE_LOCALE if set), and no locale prefix ever appears.
# The list can't be auto-discovered from the hub at runtime; set it here.
# AMPLIENCE_LOCALES="en-GB,fr-FR,de-DE"
