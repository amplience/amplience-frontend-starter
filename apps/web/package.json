{
  "name": "@amplience/quadratic-web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js accelerator application.",
  "type": "module",
  "//browserslist": "Modern evergreen target. Next.js reads this to decide which JS features to transpile/polyfill; without it, Next assumes old browsers and ships polyfills for Array.at/flat/flatMap, Object.fromEntries/hasOwn, String.trimStart/End (~14 KiB) that no supported browser needs.",
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 16",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@amplience/quadratic-components": "workspace:*",
    "@amplience/quadratic-content": "workspace:*",
    "@amplience/quadratic-theme": "workspace:*",
    "@amplience/quadratic-types": "workspace:*",
    "dc-visualization-sdk": "^1.1.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@amplience/quadratic-config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3"
  }
}
