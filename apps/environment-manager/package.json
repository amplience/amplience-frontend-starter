{
  "name": "@amplience/environment-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Local GUI for managing Quadratic Lite hub environments.",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"ui,api\" --prefix-colors \"cyan,yellow\" \"vite\" \"node --experimental-strip-types server/index.ts\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.7.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@amplience/quadratic-config": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "typescript": "^6.0.3",
    "vite": "^6.3.5"
  }
}
