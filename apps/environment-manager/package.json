{
  "name": "@amplience/environment-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Local GUI for managing Quadratic Lite hub environments.",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"ui,api\" --prefix-colors \"cyan,yellow\" \"vite --open\" \"node --experimental-strip-types --watch server/index.ts\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "hono": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@amplience/quadratic-config": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
