{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/media-card",
  "title": "Media card",
  "description": "A card with an optional cover image, title, body copy, and a CTA.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/image", "/title", "/description", "/href", "/cta"]
          },
          {
            "label": "⚙️ Options",
            "pointers": ["/layout", "/headingVariant", "/elevation", "/color"]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "title": "Description",
      "ui:component": "text-area"
    },
    "image": {
      "title": "Image",
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/image"
        }
      ]
    },
    "href": {
      "type": "string",
      "title": "Link",
      "description": "Makes the entire card a single link. When set, the CTA is ignored."
    },
    "if": {
      "properties": {
        "href": {
          "const": ""
        }
      }
    },
    "then": {
      "properties": {
        "cta": {
          "title": "CTA",
          "type": "object",
          "allOf": [
            {
              "$ref": "https://quadratic.amplience.com/v2/partials/cta"
            }
          ],
          "description": "Rendered inside the card body. Only used when Link is not set."
        }
      }
    },
    "layout": {
      "type": "string",
      "enum": ["above", "beside", "dynamic", "overlay"],
      "title": "Layout",
      "description": "Image and body arrangement.",
      "default": "above"
    },
    "headingVariant": {
      "type": "string",
      "enum": ["h2", "h3", "h4", "h5", "h6"],
      "title": "Heading level",
      "description": "Heading element for the card title.",
      "default": "h3"
    },
    "elevation": {
      "type": "string",
      "enum": ["flat", "raised", "bordered"],
      "title": "Elevation",
      "description": "Card surface treatment.",
      "default": "raised"
    },
    "color": {
      "type": "string",
      "enum": ["white", "light", "dark", "black", "primary", "secondary", "tertiary"],
      "title": "Surface colour",
      "description": "Card surface colour.",
      "default": "white"
    }
  },
  "propertyOrder": [
    "title",
    "description",
    "image",
    "href",
    "cta",
    "layout",
    "headingVariant",
    "elevation",
    "color"
  ],
  "required": ["title"]
}
