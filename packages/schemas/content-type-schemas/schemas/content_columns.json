{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/columns",
  "title": "Columns",
  "description": "A fixed, non-wrapping set of equal-width columns — each item occupies one column.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/items"]
          },
          {
            "label": "⚙️ Options",
            "pointers": ["/gap", "/alignItems", "/backgroundColor", "/maxWidth", "/gutter"]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "items": {
      "title": "Items",
      "description": "One content item per column.",
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
          },
          {
            "properties": {
              "contentType": {
                "enum": [
                  "https://quadratic.amplience.com/v2/content/hero",
                  "https://quadratic.amplience.com/v2/content/markdown-block",
                  "https://quadratic.amplience.com/v2/content/columns",
                  "https://quadratic.amplience.com/v2/content/grid",
                  "https://quadratic.amplience.com/v2/content/media-card",
                  "https://quadratic.amplience.com/v2/content/image"
                ]
              }
            }
          }
        ]
      }
    },
    "gap": {
      "type": "number",
      "title": "Gap (px)",
      "description": "Gap between columns. If empty, defaults to var(--gap)",
      "minimum": 0
    },
    "alignItems": {
      "type": "string",
      "enum": ["top", "center", "bottom"],
      "title": "Vertical alignment",
      "description": "Vertical alignment of column children within the row."
    },
    "backgroundColor": {
      "type": "string",
      "enum": ["primary", "secondary", "tertiary", "light", "dark", "black", "white"],
      "title": "Background colour"
    },
    "maxWidth": {
      "type": "string",
      "enum": ["narrow", "default", "wide", "none"],
      "title": "Max width",
      "default": "default"
    },
    "gutter": {
      "type": "boolean",
      "title": "Gutter",
      "description": "Inset columns from the viewport edge with horizontal padding."
    }
  },
  "propertyOrder": ["items", "gap", "alignItems", "backgroundColor", "maxWidth", "gutter"]
}
