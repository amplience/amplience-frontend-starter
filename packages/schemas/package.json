{
  "name": "@amplience/quadratic-schemas",
  "version": "0.0.0",
  "private": true,
  "description": "Content-type schemas as code (ADR-0012). The canonical JSON Schemas for the base-site content model, in the layout dc-cli imports — wrappers at content-type-schemas/, schema bodies at content-type-schemas/schemas/. INTERIM: imported via dc-cli wrapper scripts until the automation CLI (QL-58) supersedes them.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "hub:import": "node --env-file-if-exists=.env scripts/hub-import.mjs all",
    "hub:import:schemas": "node --env-file-if-exists=.env scripts/hub-import.mjs schemas",
    "hub:import:types": "node --env-file-if-exists=.env scripts/hub-import.mjs types",
    "hub:import:content": "node --env-file-if-exists=.env scripts/hub-import.mjs content",
    "hub:wipe": "node --env-file-if-exists=.env scripts/hub-wipe.mjs"
  },
  "dependencies": {
    "@amplience/quadratic-content": "workspace:*"
  },
  "devDependencies": {
    "@amplience/dc-cli": "^0.31.0",
    "@amplience/quadratic-config": "workspace:*",
    "ajv": "^8.17.1"
  }
}
