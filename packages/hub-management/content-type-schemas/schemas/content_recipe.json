{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/recipe",
  "title": "Recipe",
  "description": "Single content item holding everything needed for a recipe page, card and PDF. Built by Workforce from a recipe source (e.g. Nutritics) or an intake form.",
  "allOf": [{ "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content" }],
  "type": "object",
  "properties": {
    "recipeId": {
      "title": "Source recipe ID",
      "description": "e.g. U1234567. Used as the key between the recipe source, the CMS and the website.",
      "type": "string",
      "pattern": "^U[0-9]+$"
    },
    "title": {
      "title": "Recipe name",
      "description": "As supplied by the chef. Not rewritten.",
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "slug": {
      "title": "URL slug",
      "description": "e.g. slow-roast-tomato-soup",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "subtitle": {
      "title": "Chef's summary",
      "description": "Short description as supplied by the chef or source system. Not rewritten.",
      "type": "string",
      "maxLength": 300
    },
    "serves": { "title": "Serves", "type": "integer", "minimum": 1 },
    "heroImage": {
      "title": "Recipe image",
      "description": "Master image. Hero and card crops are delivered by Dynamic Media.",
      "allOf": [{ "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/image-link" }]
    },
    "heroAltText": { "title": "Image alt text", "type": "string", "maxLength": 200 },
    "imageIsAiEnhanced": {
      "title": "Image AI-enhanced",
      "description": "Set by Workforce when the image was regenerated at higher resolution.",
      "type": "boolean",
      "default": false
    },
    "copy": {
      "title": "Marketing copy",
      "description": "Generated by Workforce in the brand tone of voice, approved by a reviewer.",
      "type": "object",
      "properties": {
        "intro": { "title": "Intro", "type": "string", "format": "markdown", "maxLength": 800 },
        "cardBlurb": { "title": "Card blurb", "type": "string", "maxLength": 160 },
        "menuLine": {
          "title": "Menu description",
          "description": "Optional diner-facing line operators can use on their menus.",
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "ingredients": {
      "title": "Ingredients",
      "description": "Taken verbatim from the recipe source. Never rewritten.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "productCode": {
            "title": "Product code",
            "description": "Leave blank for ingredients with no catalogue product.",
            "type": "string",
            "pattern": "^[0-9]*$"
          },
          "name": { "title": "Ingredient", "type": "string", "minLength": 1 },
          "quantity": { "title": "Quantity", "description": "e.g. 280g", "type": "string" },
          "portion": {
            "title": "Portion description",
            "description": "e.g. 1 x Each",
            "type": "string"
          }
        },
        "required": ["name"]
      }
    },
    "preparation": { "title": "Preparation", "type": "string", "format": "markdown" },
    "methodSteps": {
      "title": "Method steps",
      "description": "One entry per step, verbatim from the recipe source.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "methodNotes": {
      "title": "Chef's notes",
      "description": "e.g. NB lines from the recipe.",
      "type": "string",
      "format": "markdown"
    },
    "allergens": {
      "title": "Contains (allergens)",
      "description": "UK 14 allergens, verbatim from the recipe source.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Celery",
          "Cereals containing gluten",
          "Crustaceans",
          "Eggs",
          "Fish",
          "Lupin",
          "Milk",
          "Molluscs",
          "Mustard",
          "Nuts",
          "Peanuts",
          "Sesame",
          "Soya",
          "Sulphur dioxide and sulphites"
        ]
      }
    },
    "nutrition": {
      "title": "Nutrition",
      "type": "object",
      "properties": {
        "kcalPer100g": { "title": "Kcal per 100g", "type": "number", "minimum": 0 },
        "carbsPercent": {
          "title": "Carbs (% of energy)",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "proteinPercent": {
          "title": "Protein (% of energy)",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "fatPercent": {
          "title": "Fat (% of energy)",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "portionWeightG": { "title": "Portion weight (g)", "type": "number", "minimum": 0 },
        "portionKcal": { "title": "Kcal per portion", "type": "number", "minimum": 0 }
      }
    },
    "seo": {
      "title": "SEO",
      "type": "object",
      "properties": {
        "metaTitle": { "title": "Meta title", "type": "string", "maxLength": 60 },
        "metaDescription": { "title": "Meta description", "type": "string", "maxLength": 155 }
      }
    },
    "recipePdfUrl": {
      "title": "Recipe PDF URL",
      "description": "Downloadable recipe card. Leave blank until the PDF is generated.",
      "type": "string",
      "format": "uri"
    },
    "source": {
      "title": "Source",
      "type": "object",
      "properties": {
        "origin": { "title": "Created from", "type": "string", "enum": ["nutritics", "form"] },
        "sourceLastModified": {
          "title": "Source last modified",
          "type": "string",
          "format": "date"
        }
      }
    }
  },
  "propertyOrder": [
    "recipeId",
    "title",
    "slug",
    "subtitle",
    "serves",
    "heroImage",
    "heroAltText",
    "imageIsAiEnhanced",
    "copy",
    "ingredients",
    "preparation",
    "methodSteps",
    "methodNotes",
    "allergens",
    "nutrition",
    "seo",
    "recipePdfUrl",
    "source"
  ],
  "required": ["recipeId", "title", "ingredients", "methodSteps"]
}
