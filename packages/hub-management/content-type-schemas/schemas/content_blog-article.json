{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/blog-article",
  "title": "Blog Article",
  "description": "A blog article page — editorial metadata plus an ordered list of slots the renderer composes.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    },
    {
      "$ref": "https://quadratic.amplience.com/v2/partials/seo"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/slots"]
          },
          {
            "label": "📰 Article",
            "pointers": [
              "/coverImage",
              "/author",
              "/publishDate",
              "/category",
              "/tags",
              "/readTime"
            ]
          },
          {
            "label": "🔗 URL",
            "pointers": ["/_meta/deliveryKeys/values"]
          },
          {
            "label": "⚙️ Metadata",
            "pointers": [
              "/title",
              "/description",
              "/keywords",
              "/canonicalUrl",
              "/robots",
              "/social"
            ]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "_meta": {
      "title": "Delivery",
      "type": "object",
      "properties": {
        "deliveryKeys": {
          "title": "Delivery keys",
          "description": "Variant delivery keys for this item. Use the {site}/blog/{slug} convention (ADR-0014) — e.g. acme/blog/getting-started.",
          "type": "object",
          "properties": {
            "values": {
              "title": "URL",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "title": "URL",
                    "minLength": 1,
                    "maxLength": 150
                  }
                }
              }
            }
          }
        }
      }
    },
    "title": {
      "description": "Article headline — <title> and SEO."
    },
    "social": {
      "description": "Open Graph overrides. Unset fields fall back to the article's own title and description."
    },
    "canonicalUrl": {
      "description": "Rarely set — when absent, the canonical defaults to the article's /blog/{slug} path."
    },
    "coverImage": {
      "title": "Cover Image",
      "description": "Hero image or video for the article — shown in the article header and article cards on the archive page. Video plays as an ambient background.",
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/rich-media"
        }
      ]
    },
    "author": {
      "type": "string",
      "title": "Author",
      "description": "Author's display name."
    },
    "publishDate": {
      "type": "string",
      "title": "Publish Date",
      "description": "ISO 8601 date string, e.g. 2026-06-29. Drives the date shown on the article and archive sort order."
    },
    "category": {
      "type": "string",
      "title": "Category",
      "description": "Free-text category label (e.g. \"Getting Started\", \"Best Practices\"). A managed DC content type is the natural MVP upgrade path."
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "description": "Topic tags — used for filtering and display.",
      "items": {
        "type": "string"
      }
    },
    "readTime": {
      "type": "number",
      "title": "Read Time (minutes)",
      "description": "Estimated reading time in minutes.",
      "minimum": 1
    },
    "slots": {
      "title": "Slots",
      "description": "Ordered slots composing the article body — same pattern as Page.",
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
          },
          {
            "properties": {
              "contentType": {
                "enum": ["https://quadratic.amplience.com/v2/slots/slot"]
              }
            }
          }
        ]
      }
    }
  },
  "propertyOrder": [
    "title",
    "description",
    "keywords",
    "social",
    "canonicalUrl",
    "robots",
    "coverImage",
    "author",
    "publishDate",
    "category",
    "tags",
    "readTime",
    "slots"
  ]
}
