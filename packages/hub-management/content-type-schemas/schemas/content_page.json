{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/page",
  "title": "Page",
  "description": "A routable page — head metadata plus an ordered list of slots the renderer composes.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/slots"]
          },
          {
            "label": "🔗 URL",
            "pointers": ["/_meta/deliveryKeys/values"]
          },
          {
            "label": "⚙️ Metadata",
            "pointers": [
              "/title",
              "/description",
              "/keywords",
              "/canonicalUrl",
              "/robots",
              "/social"
            ]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "_meta": {
      "title": "Delivery",
      "type": "object",
      "properties": {
        "deliveryKeys": {
          "title": "Delivery keys",
          "description": "Variant delivery keys for this item, namespaced by site (ADR-0014): {site}/{path} — e.g. acme/about/team. Any key retrieves the item; all keys are returned in the delivery response.",
          "type": "object",
          "properties": {
            "values": {
              "title": "URL",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "title": "URL",
                    "minLength": 1,
                    "maxLength": 150
                  }
                }
              }
            }
          }
        }
      }
    },
    "title": {
      "type": "string",
      "title": "Title",
      "description": "Document title — <title> and SEO."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Meta description — search snippets and social previews.",
      "ui:component": "text-area"
    },
    "keywords": {
      "type": "array",
      "title": "Keywords",
      "description": "Meta keywords. Low SEO weight today, but cheap to carry.",
      "items": {
        "type": "string"
      }
    },
    "social": {
      "type": "object",
      "title": "Social card",
      "description": "Open Graph overrides. Unset fields fall back to the page's own title and description.",
      "properties": {
        "title": {
          "type": "string",
          "title": "Social title"
        },
        "description": {
          "type": "string",
          "title": "Social description",
          "ui:component": "text-area"
        },
        "image": {
          "title": "Social image",
          "allOf": [
            {
              "$ref": "https://quadratic.amplience.com/v2/partials/media"
            }
          ]
        }
      },
      "propertyOrder": ["title", "description", "image"]
    },
    "canonicalUrl": {
      "type": "string",
      "title": "Canonical URL",
      "description": "Rarely set — when absent, the canonical defaults to the page's own route path."
    },
    "robots": {
      "type": "object",
      "title": "Robots",
      "description": "Absent flags mean indexable and followable — editors opt out, never in.",
      "properties": {
        "noindex": {
          "type": "boolean",
          "title": "No index"
        },
        "nofollow": {
          "type": "boolean",
          "title": "No follow"
        }
      }
    },
    "slots": {
      "title": "Slots",
      "description": "Ordered slots composing the page body.",
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
          },
          {
            "properties": {
              "contentType": {
                "enum": ["https://quadratic.amplience.com/v2/slots/slot"]
              }
            }
          }
        ]
      }
    }
  },
  "propertyOrder": ["title", "description", "keywords", "social", "canonicalUrl", "robots", "slots"]
}
