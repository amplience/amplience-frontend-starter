{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/page",
  "title": "Page",
  "description": "A routable page — head metadata plus an ordered list of slots the renderer composes.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    },
    {
      "$ref": "https://quadratic.amplience.com/v2/partials/seo"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/slots"]
          },
          {
            "label": "🔗 URL(s)",
            "pointers": ["/_meta/deliveryKeys/values"]
          },
          {
            "label": "⚙️ Metadata",
            "pointers": [
              "/title",
              "/description",
              "/keywords",
              "/canonicalUrl",
              "/robots",
              "/social"
            ]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "_meta": {
      "title": "Delivery",
      "type": "object",
      "properties": {
        "deliveryKeys": {
          "title": "Delivery keys",
          "description": "Variant delivery keys for this item, namespaced by site (ADR-0014): {site}/{path} — e.g. acme/about/team. Any key retrieves the item; all keys are returned in the delivery response.",
          "type": "object",
          "properties": {
            "values": {
              "title": "URL",
              "description": "Serve the page at this URL",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "description": "Use the format {siteKey}/slug\n(e.g. acme site would have acme/about/team)",
                    "title": "Delivery Key",
                    "minLength": 1,
                    "maxLength": 150
                  }
                }
              }
            }
          }
        }
      }
    },
    "title": {
      "description": "Document title — <title> and SEO."
    },
    "social": {
      "description": "Open Graph overrides. Unset fields fall back to the page's own title and description."
    },
    "canonicalUrl": {
      "description": "Rarely set — when absent, the canonical defaults to the page's own route path."
    },
    "slots": {
      "title": "Slots",
      "description": "Ordered slots composing the page body.",
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
          },
          {
            "properties": {
              "contentType": {
                "enum": ["https://quadratic.amplience.com/v2/slots/slot"]
              }
            }
          }
        ]
      }
    }
  },
  "propertyOrder": ["title", "description", "keywords", "social", "canonicalUrl", "robots", "slots"]
}
