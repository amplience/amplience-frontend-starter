{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/header-row",
  "title": "Header Row",
  "description": "A single horizontal row within the header — contains logos, menus, and icon buttons.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/items"]
          },
          {
            "label": "⚙️ Options",
            "pointers": ["/backgroundColor", "/customCss"]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "items": {
      "title": "Items",
      "description": "Ordered list of items in this row (Logo, Menu, IconButton, or Menu Toggle Button).",
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
          },
          {
            "properties": {
              "contentType": {
                "enum": [
                  "https://quadratic.amplience.com/v2/content/header-group",
                  "https://quadratic.amplience.com/v2/content/hierarchy-menu",
                  "https://quadratic.amplience.com/v2/content/icon-button",
                  "https://quadratic.amplience.com/v2/content/logo",
                  "https://quadratic.amplience.com/v2/content/menu",
                  "https://quadratic.amplience.com/v2/content/menu-toggle-button",
                  "https://quadratic.amplience.com/v2/content/locale-selector"
                ]
              }
            }
          }
        ]
      }
    },
    "backgroundColor": {
      "title": "Background colour",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/colour#/definitions/palette" }
      ]
    },
    "customCss": {
      "title": "Custom CSS (advanced)",
      "description": "Optional. This CSS applies to this particular header row and its children, nowhere else.",
      "type": "string",
      "ui:extension": { "name": "css-editor" },
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/block-css#/definitions/css" }
      ]
    }
  },
  "propertyOrder": ["items", "backgroundColor", "customCss", "foregroundColor"]
}
