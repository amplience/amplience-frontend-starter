{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/partials/image",
  "title": "Image",
  "description": "An image with intrinsic dimensions and alt text — the shape the Image atom renders. A ready-made URL rather than a media link; Dynamic Media support is a future enhancement.",
  "type": "object",
  "properties": {
    "src": {
      "type": "string",
      "title": "Image URL",
      "description": "Absolute URL of the image."
    },
    "alt": {
      "type": "string",
      "title": "Alt text",
      "description": "Accessible description of the image. Required — decorative images should explain their decorative role."
    },
    "width": {
      "type": "integer",
      "title": "Intrinsic width (px)",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "title": "Intrinsic height (px)",
      "minimum": 1
    },
    "aspectRatio": {
      "type": "string",
      "title": "Aspect ratio",
      "description": "Optional CSS aspect-ratio override, e.g. \"16/9\"."
    }
  },
  "propertyOrder": ["src", "alt", "width", "height", "aspectRatio"],
  "required": ["src", "alt", "width", "height"]
}
