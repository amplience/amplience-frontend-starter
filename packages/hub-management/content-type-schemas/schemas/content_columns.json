{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/columns",
  "title": "Columns Block",
  "description": "A fixed, non-wrapping set of equal-width columns — each item occupies one column.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/sectionHeader", "/items"]
          },
          {
            "label": "⚙️ Options",
            "pointers": ["/gap", "/alignItems", "/backgroundColor", "/maxWidth", "/gutter"]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "sectionHeader": {
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/section-header#/definitions/section-header"
        }
      ]
    },
    "items": {
      "title": "Column Content",
      "description": "One content item per column.",
      "type": "array",
      "items": {
        "$ref": "https://quadratic.amplience.com/v2/partials/content-blocks"
      }
    },
    "gap": {
      "type": "number",
      "title": "Gap (px)",
      "description": "Gap between columns. If empty, defaults to var(--gap)",
      "minimum": 0
    },
    "alignItems": {
      "type": "string",
      "enum": ["top", "center", "bottom"],
      "title": "Vertical alignment",
      "description": "Vertical alignment of column children within the row."
    },
    "backgroundColor": {
      "title": "Background colour",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/colour#/definitions/palette" }
      ]
    },
    "maxWidth": {
      "title": "Max width",
      "default": "default",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/container#/definitions/max-width" }
      ]
    },
    "gutter": {
      "title": "Gutter",
      "description": "Inset columns from the viewport edge with horizontal padding.",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/container#/definitions/gutter" }
      ]
    }
  },
  "propertyOrder": [
    "sectionHeader",
    "items",
    "gap",
    "alignItems",
    "backgroundColor",
    "maxWidth",
    "gutter"
  ]
}
