{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/hierarchy-menu",
  "title": "Hierarchy Menu",
  "description": "A navigation menu managed as an Amplience hierarchy — editors see a native tree UI for authoring nested items. Functionally equivalent to Menu; the difference is authoring experience only. Both content types render using the same Menu and MenuItem components.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    },
    {
      "$ref": "http://bigcontent.io/cms/schema/v2/hierarchy#/definitions/hierarchy-node"
    }
  ],
  "trait:hierarchy": {
    "childContentTypes": [
      "https://quadratic.amplience.com/v2/content/hierarchy-menu-item",
      "https://quadratic.amplience.com/v2/content/icon-button"
    ]
  },
  "trait:sortable": {
    "sortBy": [
      {
        "key": "default",
        "paths": ["/_meta/hierarchy/position"]
      }
    ]
  },
  "type": "object",
  "properties": {
    "_meta": {
      "title": "Delivery",
      "type": "object",
      "properties": {
        "deliveryKeys": {
          "title": "Delivery keys",
          "type": "object",
          "properties": {
            "values": {
              "title": "Delivery Keys",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "title": "Delivery Key",
                    "minLength": 1,
                    "maxLength": 150
                  }
                }
              }
            }
          }
        }
      }
    },
    "useMobileLayout": {
      "type": "boolean",
      "title": "Use mobile menu layout on small screens",
      "description": "Collapses the menu into a hamburger drawer on small viewports."
    },
    "display": {
      "type": "string",
      "enum": ["dropdownOnHover", "megaMenuOnHover", "megaMenu"],
      "title": "Display mode",
      "description": "Controls how the menu renders: dropdownOnHover (default top-nav), megaMenuOnHover (wide panel on hover), or megaMenu (always expanded, for footers).",
      "default": "dropdownOnHover"
    }
  },
  "propertyOrder": ["useMobileLayout", "display"]
}
