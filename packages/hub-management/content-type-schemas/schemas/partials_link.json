{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/partials/link",
  "title": "Link",
  "description": "Where a link goes, chosen with a content palette (object): a custom URL, a page or blog article, a product, or a product category.",
  "type": "object",
  "required": ["type"],
  "oneOf": [
    {
      "type": "object",
      "title": "Custom URL",
      "description": "A site path such as /about, or a full https:// URL.",
      "properties": {
        "type": { "const": "url", "ui:component": "none" },
        "url": {
          "type": "string",
          "title": "URL",
          "minLength": 1,
          "pattern": "^(?!https?\\/\\/)(?:(?:https?:\\/\\/)(?:localhost|(?:[A-Za-z0-9-]+\\.)+[A-Za-z]{2,})(?::\\d{2,5})?(?:\\/[^\\s?#]*)?(?:\\?[^\\s#]*)?(?:#[^\\s]*)?|\\/(?:[^\\s?#]+(?:\\/[^\\s?#]*)*)?(?:\\?[^\\s#]*)?(?:#[^\\s]*)?|(?:\\.\\.?\\/)?[^\\s/:?#]+(?:\\/[^\\s?#]*)*(?:\\?[^\\s#]*)?(?:#[^\\s]*)?)$"
        }
      },
      "required": ["type"]
    },
    {
      "type": "object",
      "title": "Page",
      "description": "A page or blog article. The link follows it if its URL changes.",
      "properties": {
        "type": { "const": "page", "ui:component": "none" },
        "page": {
          "title": "Page",
          "allOf": [
            {
              "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-reference"
            },
            {
              "properties": {
                "contentType": {
                  "enum": [
                    "https://quadratic.amplience.com/v2/content/page",
                    "https://quadratic.amplience.com/v2/content/blog-article"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": ["type"]
    },
    {
      "type": "object",
      "title": "Product",
      "description": "A product page, picked from the hub's product source.",
      "properties": {
        "type": { "const": "product", "ui:component": "none" },
        "product": {
          "type": "string",
          "title": "Product",
          "minLength": 1
        }
      },
      "required": ["type"]
    },
    {
      "type": "object",
      "title": "Product category",
      "description": "A category listing page, picked from the hub's product source.",
      "properties": {
        "type": { "const": "category", "ui:component": "none" },
        "category": {
          "type": "string",
          "title": "Category",
          "minLength": 1
        }
      },
      "required": ["type"]
    }
  ]
}
