{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/markdown-block",
  "title": "Rich Text Block",
  "description": "A markdown content section with optional CTAs.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/content", "/ctas"]
          },
          {
            "label": "⚙️ Options",
            "pointers": ["/backgroundColor", "/maxWidth", "/gutter"]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "content": {
      "title": "Content",
      "description": "Markdown source. Standard CommonMark.",
      "allOf": [{ "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/localized-value" }],
      "properties": {
        "values": {
          "items": {
            "properties": {
              "value": {
                "type": "string",
                "title": "Content",
                "description": "Markdown source. Standard CommonMark.",
                "format": "markdown",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "ctas": {
      "type": "array",
      "title": "CTAs",
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "https://quadratic.amplience.com/v2/partials/cta"
          }
        ]
      }
    },
    "backgroundColor": {
      "title": "Background colour",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/colour#/definitions/palette" }
      ]
    },
    "maxWidth": {
      "title": "Max width",
      "default": "default",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/container#/definitions/max-width" }
      ]
    },
    "gutter": {
      "title": "Gutter",
      "description": "Inset content from the viewport edge with horizontal padding.",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/container#/definitions/gutter" }
      ]
    }
  },
  "propertyOrder": ["content", "ctas", "backgroundColor", "maxWidth", "gutter"],
  "required": ["content"]
}
