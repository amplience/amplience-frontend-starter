{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/icon-button",
  "title": "Icon Button",
  "description": "A clickable icon from the design system's icon set.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "type": "object",
  "properties": {
    "icon": {
      "title": "Icon",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/icon#/definitions/icon-name" }
      ]
    },
    "label": {
      "type": "string",
      "title": "Accessible label",
      "description": "Screen reader label for this button (required for accessibility)."
    },
    "link": {
      "type": "string",
      "title": "Link",
      "description": "URL this button navigates to."
    },
    "visibility": {
      "type": "string",
      "title": "Visibility",
      "description": "Restrict this button to a single breakpoint. Leave unset to show it at all breakpoints.",
      "enum": ["mobileOnly", "desktopOnly"]
    }
  },
  "propertyOrder": ["icon", "label", "link", "visibility"],
  "required": ["icon", "label"]
}
