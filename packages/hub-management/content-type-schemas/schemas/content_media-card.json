{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/media-card",
  "title": "Card",
  "description": "A card with an optional cover image, title, body copy, and a CTA.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/image", "/title", "/description", "/links"]
          },
          {
            "label": "⚙️ Options",
            "pointers": ["/layout", "/headingVariant", "/elevation", "/color"]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "media": {
      "title": "Media",
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/media"
        }
      ]
    },
    "title": {
      "title": "Title",
      "minLength": 1,
      "allOf": [
        { "$ref": "http://bigcontent.io/cms/schema/v1/localization#/definitions/localized-string" }
      ]
    },
    "description": {
      "title": "Description",
      "allOf": [
        { "$ref": "http://bigcontent.io/cms/schema/v1/localization#/definitions/localized-string" }
      ]
    },
    "links": {
      "type": "object",
      "title": "Links",
      "properties": {
        "href": {
          "type": "string",
          "title": "Card Link",
          "description": "Makes the entire card a single link. When set, the CTA is ignored."
        }
      },
      "if": {
        "properties": {
          "href": {
            "const": ""
          }
        }
      },
      "then": {
        "properties": {
          "cta": {
            "title": "CTA",
            "type": "object",
            "allOf": [
              {
                "$ref": "https://quadratic.amplience.com/v2/partials/cta"
              }
            ],
            "description": "Rendered inside the card body. Only used when Link is not set."
          }
        }
      }
    },
    "layout": {
      "type": "string",
      "enum": ["above", "beside", "dynamic", "overlay"],
      "title": "Layout",
      "description": "Image and body arrangement.",
      "default": "above"
    },
    "headingVariant": {
      "type": "string",
      "enum": ["h2", "h3", "h4", "h5", "h6"],
      "title": "Heading level",
      "description": "Heading element for the card title.",
      "default": "h3"
    },
    "elevation": {
      "type": "string",
      "enum": ["flat", "raised", "bordered"],
      "title": "Card Type",
      "default": "raised"
    },
    "color": {
      "type": "string",
      "enum": ["white", "light", "dark", "black", "primary", "secondary", "tertiary"],
      "title": "Card colour",
      "default": "white"
    }
  },
  "propertyOrder": [
    "title",
    "description",
    "media",
    "href",
    "cta",
    "layout",
    "headingVariant",
    "elevation",
    "color"
  ],
  "required": ["title"]
}
