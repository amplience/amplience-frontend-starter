{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/media-card",
  "title": "Card",
  "description": "A card with an optional cover image, title, body copy, and a CTA.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/media", "/title", "/description", "/links"]
          },
          {
            "label": "⚙️ Options",
            "pointers": [
              "/layout",
              "/imageSize",
              "/alignment",
              "/headingVariant",
              "/elevation",
              "/color",
              "/customCss"
            ]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "media": {
      "title": "Media",
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/rich-media"
        }
      ]
    },
    "title": {
      "title": "Title",
      "minLength": 1,
      "allOf": [
        { "$ref": "http://bigcontent.io/cms/schema/v1/localization#/definitions/localized-string" }
      ]
    },
    "description": {
      "title": "Description",
      "allOf": [
        { "$ref": "http://bigcontent.io/cms/schema/v1/localization#/definitions/localized-string" }
      ]
    },
    "links": {
      "type": "object",
      "title": "Links",
      "properties": {
        "href": {
          "type": "string",
          "title": "Card Link",
          "description": "Makes the entire card a single link. When set, the CTA is ignored."
        }
      },
      "if": {
        "properties": {
          "href": {
            "const": ""
          }
        }
      },
      "then": {
        "properties": {
          "cta": {
            "title": "CTA",
            "type": "object",
            "allOf": [
              {
                "$ref": "https://quadratic.amplience.com/v2/partials/cta"
              }
            ],
            "description": "Rendered inside the card body. Only used when Link is not set."
          }
        }
      }
    },
    "layout": {
      "type": "string",
      "enum": ["above", "beside", "dynamic", "overlay"],
      "title": "Layout",
      "description": "Image and body arrangement.",
      "default": "above"
    },
    "imageSize": {
      "type": "string",
      "enum": ["cover", "icon"],
      "title": "Image size",
      "description": "Cover: full-bleed image placed by Layout. Icon: small uncropped image above the title (Layout then always stacks).",
      "default": "cover"
    },
    "alignment": {
      "type": "string",
      "enum": ["left", "center", "right"],
      "title": "Alignment",
      "description": "Horizontal alignment of the icon, text and CTA.",
      "default": "left"
    },
    "headingVariant": {
      "type": "string",
      "enum": ["h2", "h3", "h4", "h5", "h6"],
      "title": "Heading level",
      "description": "Heading element for the card title.",
      "default": "h3"
    },
    "elevation": {
      "type": "string",
      "enum": ["flat", "raised", "bordered"],
      "title": "Card Type",
      "default": "raised"
    },
    "color": {
      "title": "Card colour",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/colour#/definitions/palette" }
      ],
      "default": "white"
    },
    "customCss": {
      "title": "Custom CSS (advanced)",
      "description": "Optional. CSS for this block only — it also reaches any blocks nested inside it. Bare declarations style the block itself (background: …); nested rules style what's inside (h2 { … }, &:hover { … }, @media … { … }); custom properties (--color-primary: …) flow down to child blocks. Leave blank for none.",
      "type": "string",
      "ui:extension": { "name": "css-editor" },
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/block-css#/definitions/css" }
      ]
    }
  },
  "propertyOrder": [
    "title",
    "description",
    "media",
    "href",
    "cta",
    "layout",
    "imageSize",
    "alignment",
    "headingVariant",
    "elevation",
    "color",
    "customCss"
  ],
  "required": ["title"]
}
