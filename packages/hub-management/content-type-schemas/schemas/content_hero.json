{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/hero",
  "title": "Hero Block",
  "description": "A leading banner — title, optional subtitle, image, and CTAs, with overlay and positioning controls.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Foreground",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Foreground",
            "pointers": [
              "/preTitle",
              "/title",
              "/subtitle",
              "/description",
              "/ctas",
              "/textColor",
              "/contentPanelColor"
            ]
          },
          {
            "label": "🎨 Overlay",
            "pointers": ["/overlayStyle", "/overlayColor", "/overlayIntensity"]
          },
          {
            "label": "🖼️ Background",
            "pointers": ["/media", "/mobileOverride", "/mobileMedia", "/backgroundColor"]
          },
          {
            "label": "⚙️ Layout",
            "pointers": [
              "/contentPositionMobile",
              "/contentPositionDesktop",
              "/heightBehaviour",
              "/verticalPosition",
              "/horizontalPosition",
              "/textAlign",
              "/contentWidth",
              "/contentPadding",
              "/contentPaddingVertical",
              "/contentPaddingHorizontal",
              "/maxWidth",
              "/minHeight",
              "/maxHeight",
              "/customCss"
            ]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "preTitle": {
      "allOf": [
        {
          "$ref": "http://bigcontent.io/cms/schema/v1/localization#/definitions/localized-string"
        },
        {
          "title": "Pre-title"
        }
      ]
    },
    "title": {
      "allOf": [
        {
          "$ref": "http://bigcontent.io/cms/schema/v1/localization#/definitions/localized-string"
        },
        {
          "title": "Title",
          "description": "Drives the <h1> and the section's accessible name.",
          "minLength": 1
        }
      ]
    },
    "subtitle": {
      "allOf": [
        {
          "$ref": "http://bigcontent.io/cms/schema/v1/localization#/definitions/localized-string"
        },
        {
          "title": "Subtitle"
        }
      ]
    },
    "description": {
      "allOf": [
        {
          "$ref": "http://bigcontent.io/cms/schema/v1/localization#/definitions/localized-string"
        },
        {
          "title": "Description"
        }
      ]
    },
    "media": {
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/rich-media"
        },
        {
          "description": "Image or video. A video in a hero always plays as an ambient background: muted, looping, no controls. The mobile override only applies to images."
        }
      ]
    },
    "mobileOverride": {
      "type": "boolean",
      "title": "Mobile override",
      "description": "Show a different image on mobile (≤768px). When on, set the Mobile media below.",
      "default": false
    },
    "ctas": {
      "type": "array",
      "title": "CTAs",
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "https://quadratic.amplience.com/v2/partials/cta"
          }
        ]
      }
    },
    "contentPositionMobile": {
      "type": "string",
      "enum": ["overlay", "above", "beneath"],
      "title": "Content position (mobile)",
      "description": "Where content sits relative to the image at ≤768px."
    },
    "contentPositionDesktop": {
      "type": "string",
      "enum": ["overlay", "above", "beneath"],
      "title": "Content position (desktop)",
      "description": "Where content sits relative to the image at >768px.",
      "default": "overlay"
    },
    "heightBehaviour": {
      "type": "string",
      "enum": ["flexible", "fitToContent", "fitToImage"],
      "title": "Height behaviour",
      "description": "How the hero's height is determined when content overlays the image."
    },
    "verticalPosition": {
      "type": "string",
      "enum": ["top", "center", "bottom"],
      "title": "Vertical position",
      "description": "Vertical position of the content within the section.",
      "default": "top"
    },
    "horizontalPosition": {
      "type": "string",
      "enum": ["left", "center", "right"],
      "title": "Horizontal position",
      "description": "Horizontal extent and alignment of the content panel."
    },
    "textAlign": {
      "type": "string",
      "enum": ["left", "center", "right"],
      "title": "Text alignment"
    },
    "overlayStyle": {
      "type": "string",
      "enum": ["gradient", "hard", "solid"],
      "title": "Overlay style",
      "description": "Style of the overlay scrim drawn over the image.",
      "default": "gradient"
    },
    "overlayColor": {
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/colour#/definitions/palette"
        },
        {
          "title": "Overlay colour",
          "description": "Colour of the overlay scrim, from the design token palette.",
          "default": "black"
        }
      ]
    },
    "overlayIntensity": {
      "type": "number",
      "title": "Overlay intensity",
      "description": "Opacity of the overlay scrim as a percentage.",
      "minimum": 0,
      "maximum": 100
    },
    "textColor": {
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/colour#/definitions/palette"
        },
        {
          "title": "Text colour"
        }
      ]
    },
    "contentPanelColor": {
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/colour#/definitions/palette"
        },
        {
          "title": "Content panel colour",
          "description": "Background colour of the content panel (title, subtitle, description, CTAs) for a contained 'card' look behind the text."
        }
      ]
    },
    "backgroundColor": {
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/colour#/definitions/background-palette"
        }
      ]
    },
    "contentWidth": {
      "type": "number",
      "title": "Foreground Content width (px)",
      "minimum": 0
    },
    "contentPadding": {
      "type": "number",
      "title": "Foreground Content padding (px)",
      "minimum": 0,
      "description": "Padding on all four sides of the foreground content. Overridden per axis by Content padding (vertical) / Content padding (horizontal) when those are set."
    },
    "contentPaddingVertical": {
      "type": "number",
      "title": "Foreground Content padding — vertical (px)",
      "minimum": 0,
      "description": "Overrides Foreground Content padding for the top and bottom edges only."
    },
    "contentPaddingHorizontal": {
      "type": "number",
      "title": "Foreground Content padding — horizontal (px)",
      "minimum": 0,
      "description": "Overrides Foreground Content padding for the left and right edges only."
    },
    "maxWidth": {
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/container#/definitions/max-width"
        },
        {
          "description": "Max-width constraint on the content slot."
        }
      ]
    },
    "minHeight": {
      "type": "number",
      "title": "Min height (px)",
      "minimum": 0
    },
    "maxHeight": {
      "type": "number",
      "title": "Max height (px)",
      "minimum": 0
    },
    "customCss": {
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/block-css#/definitions/css"
        }
      ]
    }
  },
  "if": {
    "properties": { "mobileOverride": { "const": true } },
    "required": ["mobileOverride"]
  },
  "then": {
    "properties": {
      "mobileMedia": {
        "allOf": [
          {
            "$ref": "https://quadratic.amplience.com/v2/partials/media"
          },
          {
            "title": "Mobile media",
            "description": "Shown at ≤768px when Mobile override is on. May use a different aspect ratio to the main media — each breakpoint reserves its own box, so there is no layout shift, and only the matched image downloads."
          }
        ]
      }
    },
    "required": ["mobileMedia"]
  },
  "propertyOrder": [
    "title",
    "subtitle",
    "media",
    "mobileOverride",
    "mobileMedia",
    "ctas",
    "contentPositionMobile",
    "contentPositionDesktop",
    "heightBehaviour",
    "verticalPosition",
    "horizontalPosition",
    "textAlign",
    "overlayStyle",
    "overlayColor",
    "overlayIntensity",
    "contentPanelColor",
    "textColor",
    "backgroundColor",
    "contentWidth",
    "contentPadding",
    "contentPaddingVertical",
    "contentPaddingHorizontal",
    "maxWidth",
    "minHeight",
    "maxHeight",
    "customCss"
  ],
  "required": ["title"]
}
