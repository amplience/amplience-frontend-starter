{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/partials/content-blocks",
  "title": "Content Block",
  "description": "A content-link to a renderable block — the union of block types the slot renderer accepts. Referenced by slots, columns, grid, and blog articles so the allowed set is maintained in one place.",
  "type": "object",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
    },
    {
      "properties": {
        "contentType": {
          "enum": [
            "https://quadratic.amplience.com/v2/content/columns",
            "https://quadratic.amplience.com/v2/content/grid",
            "https://quadratic.amplience.com/v2/content/hero",
            "https://quadratic.amplience.com/v2/content/markdown-block",
            "https://quadratic.amplience.com/v2/content/media",
            "https://quadratic.amplience.com/v2/content/media-card"
          ]
        }
      }
    }
  ]
}
