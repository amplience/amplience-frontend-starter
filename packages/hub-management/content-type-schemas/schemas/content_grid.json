{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/grid",
  "title": "Grid Block",
  "description": "A wrapping grid of content items — fixed columns per breakpoint, or auto-fit by minimum item width.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/title", "/subtitle", "/description", "/items"]
          },
          {
            "label": "⚙️ Options",
            "pointers": [
              "/sizingMode",
              "/columnsMobile",
              "/columnsTablet",
              "/columnsDesktop",
              "/minItemWidth",
              "/gap",
              "/alignItems",
              "/backgroundColor",
              "/maxWidth",
              "/gutter"
            ]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "title": {
      "title": "Title",
      "description": "Optional section heading",
      "allOf": [
        { "$ref": "http://bigcontent.io/cms/schema/v1/localization#/definitions/localized-string" }
      ]
    },
    "subtitle": {
      "title": "Subtitle",
      "description": "Optional section subheading",
      "allOf": [
        { "$ref": "http://bigcontent.io/cms/schema/v1/localization#/definitions/localized-string" }
      ]
    },
    "description": {
      "title": "Description",
      "description": "Optional section introduction",
      "allOf": [
        { "$ref": "http://bigcontent.io/cms/schema/v1/localization#/definitions/localized-string" }
      ]
    },
    "items": {
      "title": "Items",
      "description": "Content items laid out in the grid.",
      "type": "array",
      "items": {
        "$ref": "https://quadratic.amplience.com/v2/partials/content-blocks"
      }
    },
    "sizingMode": {
      "type": "string",
      "enum": ["fixed", "auto"],
      "title": "Sizing mode",
      "description": "fixed — explicit column counts per breakpoint; auto — fit as many columns as the minimum item width allows.",
      "default": "fixed"
    },
    "gap": {
      "type": "number",
      "title": "Gap (px)",
      "minimum": 0
    },
    "backgroundColor": {
      "title": "Background colour",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/colour#/definitions/palette" }
      ]
    },
    "maxWidth": {
      "title": "Max width",
      "default": "default",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/container#/definitions/max-width" }
      ]
    },
    "gutter": {
      "title": "Gutter",
      "description": "Inset grid items from the viewport edge with horizontal padding.",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/container#/definitions/gutter" }
      ]
    }
  },
  "if": {
    "properties": {
      "sizingMode": {
        "const": "fixed"
      }
    }
  },
  "then": {
    "properties": {
      "columnsMobile": {
        "type": "integer",
        "title": "Columns (mobile)",
        "description": "Only applies when sizing mode is fixed.",
        "minimum": 1,
        "maximum": 6
      },
      "columnsTablet": {
        "type": "integer",
        "title": "Columns (tablet)",
        "description": "Only applies when sizing mode is fixed.",
        "minimum": 1,
        "maximum": 6
      },
      "columnsDesktop": {
        "type": "integer",
        "title": "Columns (desktop)",
        "description": "Only applies when sizing mode is fixed.",
        "minimum": 1,
        "maximum": 6
      }
    }
  },
  "else": {
    "properties": {
      "minItemWidth": {
        "type": "number",
        "title": "Min item width (px)",
        "description": "Only applies when sizing mode is auto.",
        "minimum": 1
      }
    }
  },
  "propertyOrder": [
    "title",
    "subtitle",
    "description",
    "items",
    "sizingMode",
    "columnsMobile",
    "columnsTablet",
    "columnsDesktop",
    "minItemWidth",
    "gap",
    "backgroundColor",
    "maxWidth",
    "gutter"
  ]
}
