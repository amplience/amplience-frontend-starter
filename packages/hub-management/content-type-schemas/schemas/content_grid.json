{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/grid",
  "title": "Grid Block",
  "description": "A wrapping grid of content items — fixed columns per breakpoint, or auto-fit by minimum item width.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/sectionHeader", "/items"]
          },
          {
            "label": "⚙️ Options",
            "pointers": [
              "/sizingMode",
              "/columnsMobile",
              "/columnsTablet",
              "/columnsDesktop",
              "/minItemWidth",
              "/gap",
              "/alignItems",
              "/backgroundColor",
              "/maxWidth",
              "/gutter",
              "/customCss"
            ]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "sectionHeader": {
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/section-header#/definitions/section-header"
        }
      ]
    },
    "items": {
      "title": "Grid Items",
      "description": "Content items laid out in the grid.",
      "type": "array",
      "items": {
        "$ref": "https://quadratic.amplience.com/v2/partials/content-blocks"
      }
    },
    "sizingMode": {
      "type": "string",
      "enum": ["fixed", "auto"],
      "title": "Sizing mode",
      "description": "fixed — explicit column counts per breakpoint; auto — fit as many columns as the minimum item width allows.",
      "default": "fixed"
    },
    "gap": {
      "type": "number",
      "title": "Gap (px)",
      "minimum": 0
    },
    "backgroundColor": {
      "title": "Background colour",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/colour#/definitions/palette" }
      ]
    },
    "maxWidth": {
      "title": "Max width",
      "default": "default",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/container#/definitions/max-width" }
      ]
    },
    "gutter": {
      "title": "Gutter",
      "description": "Inset grid items from the viewport edge with horizontal padding.",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/container#/definitions/gutter" }
      ]
    },
    "customCss": {
      "title": "Custom CSS (advanced)",
      "description": "Optional. CSS for this block only — it also reaches any blocks nested inside it. Bare declarations style the block itself (background: …); nested rules style what's inside (h2 { … }, &:hover { … }, @media … { … }); custom properties (--color-primary: …) flow down to child blocks. Leave blank for none.",
      "type": "string",
      "ui:extension": { "name": "css-editor" },
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/block-css#/definitions/css" }
      ]
    }
  },
  "if": {
    "properties": {
      "sizingMode": {
        "const": "fixed"
      }
    }
  },
  "then": {
    "properties": {
      "columnsMobile": {
        "type": "integer",
        "title": "Columns (mobile)",
        "description": "Only applies when sizing mode is fixed.",
        "minimum": 1,
        "maximum": 6
      },
      "columnsTablet": {
        "type": "integer",
        "title": "Columns (tablet)",
        "description": "Only applies when sizing mode is fixed.",
        "minimum": 1,
        "maximum": 6
      },
      "columnsDesktop": {
        "type": "integer",
        "title": "Columns (desktop)",
        "description": "Only applies when sizing mode is fixed.",
        "minimum": 1,
        "maximum": 6
      }
    }
  },
  "else": {
    "properties": {
      "minItemWidth": {
        "type": "number",
        "title": "Min item width (px)",
        "description": "Only applies when sizing mode is auto.",
        "minimum": 1
      }
    }
  },
  "propertyOrder": [
    "sectionHeader",
    "items",
    "sizingMode",
    "columnsMobile",
    "columnsTablet",
    "columnsDesktop",
    "minItemWidth",
    "gap",
    "backgroundColor",
    "maxWidth",
    "gutter",
    "customCss"
  ]
}
