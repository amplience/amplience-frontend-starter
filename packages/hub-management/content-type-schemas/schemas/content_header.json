{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/header",
  "title": "Header",
  "description": "Site header — one or more rows of navigation content.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/rows"]
          },
          {
            "label": "⚙️ Options",
            "pointers": ["/sticky", "/maxWidth", "/customCss"]
          },
          {
            "label": "🌐 Sites",
            "pointers": ["/_meta/deliveryKeys/values"]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "_meta": {
      "title": "Delivery",
      "type": "object",
      "properties": {
        "deliveryKeys": {
          "type": "object",
          "properties": {
            "values": {
              "title": "Site",
              "description": "Apply the header to this site (e.g. acme)",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "title": "Delivery Key",
                    "description": "Use the format {siteKey}/site/header\n(e.g. acme/site/header)",
                    "minLength": 1,
                    "maxLength": 150
                  }
                }
              }
            }
          }
        }
      }
    },
    "rows": {
      "title": "Header rows",
      "description": "Ordered list of header rows (e.g. logo row, nav row).",
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
          },
          {
            "properties": {
              "contentType": {
                "enum": ["https://quadratic.amplience.com/v2/content/header-row"]
              }
            }
          }
        ]
      }
    },
    "sticky": {
      "type": "boolean",
      "title": "Sticky",
      "description": "When true, the header remains fixed at the top of the viewport on scroll."
    },
    "maxWidth": {
      "title": "Max width",
      "description": "Max-width constraint passed to child Containers.",
      "default": "default",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/container#/definitions/max-width" }
      ]
    },
    "customCss": {
      "title": "Custom CSS (advanced)",
      "description": "Optional. CSS for this block only — it also reaches any blocks nested inside it. Bare declarations style the block itself (background: …); nested rules style what's inside (h2 { … }, &:hover { … }, @media … { … }); custom properties (--color-primary: …) flow down to child blocks. Leave blank for none.",
      "type": "string",
      "ui:extension": { "name": "css-editor" },
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/block-css#/definitions/css" }
      ]
    }
  },
  "propertyOrder": ["rows", "sticky", "maxWidth", "customCss"]
}
