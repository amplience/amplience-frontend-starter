{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/media",
  "title": "Media Block",
  "description": "A standalone media section with optional caption and link. Supports DAM-backed images and video (DynamicImage, DynamicVideo) or URL-based ones (ManualImage, ExternalVideo).",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "type": "object",
  "properties": {
    "media": {
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/rich-media"
        }
      ]
    },
    "caption": {
      "allOf": [
        {
          "$ref": "http://bigcontent.io/cms/schema/v1/localization#/definitions/localized-string"
        },
        {
          "title": "Caption"
        }
      ]
    },
    "href": {
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/link" },
        {
          "title": "Link",
          "description": "Optional — wraps the media in a link. External URLs open in a new tab. A video inside a link is always ambient, so the click goes to the link, and it plays only while the link is hovered or focused."
        }
      ]
    },
    "fullBleed": {
      "type": "boolean",
      "title": "Full bleed",
      "description": "Extend the media edge-to-edge, ignoring container padding and max-width."
    },
    "backgroundColor": {
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/colour#/definitions/background-palette"
        }
      ]
    },
    "maxWidth": {
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/container#/definitions/max-width"
        },
        {
          "description": "Ignored when full bleed is on."
        }
      ]
    },
    "customCss": {
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/block-css#/definitions/css"
        }
      ]
    }
  },
  "propertyOrder": [
    "media",
    "caption",
    "href",
    "fullBleed",
    "backgroundColor",
    "maxWidth",
    "customCss"
  ],
  "required": ["media"]
}
