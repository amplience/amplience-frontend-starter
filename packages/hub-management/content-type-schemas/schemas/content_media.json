{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/media",
  "title": "Media Block",
  "description": "A standalone media section with optional caption and link. Supports DAM-backed (DynamicImage) or manually-authored (ManualImage) media.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "type": "object",
  "properties": {
    "media": {
      "title": "Media",
      "allOf": [
        {
          "$ref": "https://quadratic.amplience.com/v2/partials/media"
        }
      ]
    },
    "caption": {
      "title": "Caption",
      "allOf": [
        { "$ref": "http://bigcontent.io/cms/schema/v1/localization#/definitions/localized-string" }
      ]
    },
    "href": {
      "type": "string",
      "title": "Link",
      "description": "Optional URL — wraps the media in a link. External URLs open in a new tab."
    },
    "fullBleed": {
      "type": "boolean",
      "title": "Full bleed",
      "description": "Extend the media edge-to-edge, ignoring container padding and max-width."
    },
    "backgroundColor": {
      "title": "Background colour",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/colour#/definitions/palette" }
      ]
    },
    "maxWidth": {
      "title": "Max width",
      "description": "Ignored when full bleed is on.",
      "default": "default",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/container#/definitions/max-width" }
      ]
    }
  },
  "propertyOrder": ["media", "caption", "href", "fullBleed", "backgroundColor", "maxWidth"],
  "required": ["media"]
}
