{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quadratic.amplience.com/v2/content/footer",
  "title": "Footer",
  "description": "Site footer — one or more rows of navigation content.",
  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "📝 Content",
        "variant": "outline",
        "items": [
          {
            "label": "📝 Content",
            "pointers": ["/rows"]
          },
          {
            "label": "⚙️ Options",
            "pointers": ["/sticky", "/maxWidth"]
          },
          {
            "label": "🌐 Sites",
            "pointers": ["/_meta/deliveryKeys/values"]
          }
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "_meta": {
      "title": "Delivery",
      "type": "object",
      "properties": {
        "deliveryKeys": {
          "type": "object",
          "properties": {
            "values": {
              "title": "Site",
              "description": "Apply the footer to this site (e.g. acme)",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "title": "Delivery Key",
                    "description": "Use the format {siteKey}/site/footer\n(e.g. acme/site/footer)",
                    "minLength": 1,
                    "maxLength": 150
                  }
                }
              }
            }
          }
        }
      }
    },
    "rows": {
      "title": "Footer rows",
      "description": "Ordered list of footer rows.",
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
          },
          {
            "properties": {
              "contentType": {
                "enum": ["https://quadratic.amplience.com/v2/content/footer-row"]
              }
            }
          }
        ]
      }
    },
    "sticky": {
      "type": "boolean",
      "title": "Sticky",
      "description": "When true, the footer remains fixed at the bottom of the viewport.",
      "default": false
    },
    "maxWidth": {
      "title": "Max width",
      "description": "Max-width constraint passed to child Containers.",
      "default": "default",
      "allOf": [
        { "$ref": "https://quadratic.amplience.com/v2/partials/container#/definitions/max-width" }
      ]
    }
  },
  "propertyOrder": ["rows", "sticky", "maxWidth"]
}
