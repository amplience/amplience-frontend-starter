# Hub-import configuration (QL-92). Copy to .env in this directory — the
# hub:import scripts load it via node --env-file-if-exists. The .env copy is
# gitignored; credentials never reach version control.

# Hub name — fills the ${hub} token in visualization URIs (types step).
AMPLIENCE_HUB_NAME="quadraticlite"

# Optional: site name — the delivery-key namespace the seeded content lives
# under (ADR-0014): fixtures stage from base-site/… to <site>/… on import.
# Defaults to AMPLIENCE_HUB_NAME, the same default the web app applies, so
# hub and deployment agree without setting it. Set it (here and on the
# deployment) for a site not named after its hub. Choose once — it's baked
# into every key. Lowercase letters, digits, hyphens.
# SITE_NAME="my-site"

# Deployed frontend origin — fills the ${appUrl} token in the Production
# visualization URI (types step). No trailing slash needed.
AMPLIENCE_APP_URL="https://quadratic-lite-web.vercel.app"

# Repository IDs (DC UI → repository settings) — content step.
AMPLIENCE_REPO_CONTENT="XXXXXXXXXXXXXXXXXXXXXXXX"
AMPLIENCE_REPO_SLOTS="XXXXXXXXXXXXXXXXXXXXXXXX"

# Optional "Site Components" repository — authoring/permission boundary for
# CMS-managed site config (currently the custom-CSS content type). Leave unset
# if the deployment keeps all config in code. Only the seeding tooling reads
# it; the delivery runtime never uses repo IDs.
# AMPLIENCE_REPO_SITE_COMPONENTS="XXXXXXXXXXXXXXXXXXXXXXXX"

# Set to 1 to force-publish every imported item even when the import changed
# nothing (--republish). Normally unset: changed items publish anyway.
AMPLIENCE_REPUBLISH=""

# API client — optional as a set: omit all three to use your active dc-cli
# configuration instead.
AMPLIENCE_CLIENT_ID=""
AMPLIENCE_CLIENT_SECRET=""
AMPLIENCE_HUB_ID=""
