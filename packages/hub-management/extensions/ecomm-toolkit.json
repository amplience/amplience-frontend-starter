{
  "name": "ecomm-toolkit",
  "label": "eComm Toolkit (commercetools)",
  "description": "Product picker for commercetools. Seeded only on hubs with a commercetools block in amplience.config.json, which supplies its credentials.",
  "url": "https://ecomm-toolkit.extensions.content.amplience.net",
  "enabledForAllContentTypes": false,
  "category": "CONTENT_FIELD",
  "parameters": "{\n  \"vendor\": \"commercetools\",\n  \"codec_params\": {\n    \"project\": \"${commercetools:project}\",\n    \"language\": \"${commercetools:language}\",\n    \"client_id\": \"${commercetools:clientId}\",\n    \"client_secret\": \"${commercetools:clientSecret}\",\n    \"auth_url\": \"${commercetools:authUrl}\",\n    \"api_url\": \"${commercetools:apiUrl}\",\n    \"scope\": \"${commercetools:scope}\"\n  }\n}",
  "snippets": [],
  "settings": "{\"API\":{\"READ\":true,\"EDIT\":true},\"SANDBOX\":{\"SAME_ORIGIN\":true,\"MODALS\":false,\"NAVIGATION\":false,\"POPUPS\":false,\"POPUP_ESCAPE_SANDBOX\":false,\"DOWNLOADS\":false,\"FORMS\":false}}"
}
