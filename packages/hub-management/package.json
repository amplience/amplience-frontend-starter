{
  "name": "@amplience/frontend-starter-hub-management",
  "version": "0.0.0",
  "private": true,
  "description": "Hub configuration as code (ADR-0012). The canonical settings, content-type schemas, content types and extensions for the base-site model, each in the layout dc-cli imports — settings/, content-type-schemas/ (bodies at content-type-schemas/schemas/), content-types/, extensions/. INTERIM: seeded via dc-cli wrapper scripts until the automation CLI (QL-58) supersedes them.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "hub:import": "node --env-file-if-exists=.env scripts/hub-import.mjs all",
    "hub:import:settings": "node --env-file-if-exists=.env scripts/hub-import.mjs settings",
    "hub:import:schemas": "node --env-file-if-exists=.env scripts/hub-import.mjs schemas",
    "hub:import:types": "node --env-file-if-exists=.env scripts/hub-import.mjs types",
    "hub:import:extensions": "node --env-file-if-exists=.env scripts/hub-import.mjs extensions",
    "hub:import:webhooks": "node --env-file-if-exists=.env scripts/hub-import.mjs webhooks",
    "hub:import:content": "node --env-file-if-exists=.env scripts/hub-import.mjs content",
    "hub:wipe": "node --env-file-if-exists=.env scripts/hub-wipe.mjs",
    "hub:wipe:webhooks": "node --env-file-if-exists=.env scripts/hub-wipe.mjs webhooks"
  },
  "dependencies": {
    "@amplience/frontend-starter-content": "workspace:*"
  },
  "devDependencies": {
    "@amplience/dc-cli": "^0.31.0",
    "@amplience/frontend-starter-config": "workspace:*",
    "ajv": "^8.20.0",
    "dc-management-sdk-js": "^3.3.0"
  }
}
