# Regenerate the /docs site fixtures when their Markdown source is part of this
# commit, and stage the result — so the generated fixtures never fall behind
# docs/*.md (or the README the root page composes). CI's docs-sync job is the
# hard guarantee; this hook just keeps local commits tidy so CI stays green.
staged_docs=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(docs/.*\.md|README\.md)$' || true)
if [ -n "$staged_docs" ]; then
  echo "docs source changed — regenerating docs fixtures…"
  pnpm docs:generate || exit 1
  git add packages/content/src/mock/docs.generated.ts
  # The generator writes into whichever fixture set carries `generatedDocs: true`,
  # so glob the set rather than naming it — a rename shouldn't break staging.
  for f in packages/content/fixtures/*/pages/docs.json \
    packages/content/fixtures/*/slots/docs-main.json \
    packages/content/fixtures/*/components/docs-hero.json \
    packages/content/fixtures/*/components/docs-markdown.json; do
    [ -f "$f" ] && git add "$f"
  done
  # Sub-page trees only exist when docs/ has nested pages.
  for d in packages/content/fixtures/*/components/docs \
    packages/content/fixtures/*/pages/docs \
    packages/content/fixtures/*/slots/docs; do
    [ -d "$d" ] && git add "$d"
  done
fi

pnpm exec lint-staged
