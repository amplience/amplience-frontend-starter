{
  "name": "quadratic-lite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source accelerator for the Amplience Quadratic demo platform.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/amplience/quadratic-lite.git"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "adm-zip": ">=0.6.0",
      "axios": ">=1.18.0",
      "esbuild": ">=0.28.1",
      "lodash": ">=4.18.0",
      "postcss": ">=8.5.10",
      "sharp": ">=0.35.0",
      "shell-quote": ">=1.9.0",
      "tmp": ">=0.2.7",
      "uuid": ">=11.1.1",
      "@amplience/dc-cli>ajv": "^6.14.0"
    }
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @amplience/quadratic-web dev",
    "build": "pnpm --filter @amplience/quadratic-web build",
    "start": "pnpm --filter @amplience/quadratic-web start",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:cleanup": "ESLINT_DISABLE_NO_AUTOFIX_WRAPPER=1 eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "docs:generate": "node packages/content/scripts/generate-docs.mjs",
    "storybook": "pnpm --filter @amplience/quadratic-components storybook",
    "sb": "pnpm storybook",
    "hub:import": "pnpm --filter @amplience/quadratic-hub-management hub:import",
    "hub:import:settings": "pnpm --filter @amplience/quadratic-hub-management hub:import:settings",
    "hub:import:schemas": "pnpm --filter @amplience/quadratic-hub-management hub:import:schemas",
    "hub:import:types": "pnpm --filter @amplience/quadratic-hub-management hub:import:types",
    "hub:import:extensions": "pnpm --filter @amplience/quadratic-hub-management hub:import:extensions",
    "hub:import:content": "pnpm --filter @amplience/quadratic-hub-management hub:import:content",
    "hub:wipe": "pnpm --filter @amplience/quadratic-hub-management hub:wipe",
    "env-manager": "pnpm --filter @amplience/environment-manager dev"
  },
  "devDependencies": {
    "@amplience/quadratic-config": "workspace:*",
    "@eslint/js": "^9.39.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
