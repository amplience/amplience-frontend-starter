# Fail install if Node/pnpm engine constraints aren't met — surface env drift early.
engine-strict=true

# Resolve workspace deps with the `workspace:` protocol; reject silent fallbacks to the registry.
prefer-workspace-packages=true
link-workspace-packages=true

# Keep node_modules strict (no phantom hoisting) per ADR-0001. Add public-hoist-pattern entries
# here only when a specific upstream package proves it requires hoisting.
