{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Language & target */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    /* Strictness — per ADR-0011 §A2 (aggressive baseline) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true,
    // CSS modules are typed as index signatures by tooling — dot notation is safe
    // and cleaner. Disabled repo-wide rather than per-package to avoid the
    // consuming-tsconfig-wins problem with source-first workspace packages.
    "noPropertyAccessFromIndexSignature": false,

    /* Module hygiene */
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    /* Ergonomics */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}
